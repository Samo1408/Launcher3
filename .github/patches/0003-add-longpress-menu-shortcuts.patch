+    // ─────────────────────────────────────────────────────────────────────────
+    // Shared helper: open a path in the first available root file explorer.
+    // ─────────────────────────────────────────────────────────────────────────
+    private static void openInRootExplorer(Context context, String path) {
+        PackageManager pm = context.getPackageManager();
+        for (String explorerPkg : RootUtils.ROOT_EXPLORERS) {
+            Intent intent = new Intent(Intent.ACTION_VIEW);
+            intent.setPackage(explorerPkg);
+            intent.setDataAndType(Uri.parse("file://" + path), "resource/folder");
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK
+                    | Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            try {
+                pm.getPackageInfo(explorerPkg, 0);
+                context.startActivity(intent);
+                return;
+            } catch (PackageManager.NameNotFoundException ignored) {}
+            catch (Exception ignored) {}
+        }
+        // Fallback: generic file manager
+        Intent fallback = new Intent(Intent.ACTION_VIEW);
+        fallback.setDataAndType(Uri.parse("file://" + path), "resource/folder");
+        fallback.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        try {
+            context.startActivity(fallback);
+        } catch (Exception e) {
+            Toast.makeText(context, R.string.no_file_manager_found, Toast.LENGTH_SHORT).show();
+        }
+    }
