+    // ─────────────────────────────────────────────────────────────────────────
+    // Show App Dir shortcut (root required)
+    // Opens /data/app/<pkg> in a root file explorer.
+    // ─────────────────────────────────────────────────────────────────────────
+    public static class ShowAppDir extends SystemShortcut {
+        public ShowAppDir() {
+            super(R.drawable.ic_info_no_shadow, R.string.action_show_app_dir);
+        }
+
+        @Override
+        public View.OnClickListener getOnClickListener(final Launcher launcher,
+                final ItemInfo itemInfo) {
+            final String pkg = itemInfo.getTargetComponent() != null
+                    ? itemInfo.getTargetComponent().getPackageName() : null;
+            if (pkg == null) return null;
+            return new View.OnClickListener() {
+                @Override
+                public void onClick(View v) {
+                    AbstractFloatingView.closeAllOpenViews(launcher);
+                    // Locate actual app dir via pm path
+                    new AsyncTask<Void, Void, String>() {
+                        @Override
+                        protected String doInBackground(Void... voids) {
+                            List<String> out = RootUtils.exec("pm path " + pkg);
+                            for (String line : out) {
+                                // "package:/data/app/com.example-xxx=/base.apk"
+                                if (line.startsWith("package:")) {
+                                    String path = line.substring("package:".length());
+                                    int slash = path.lastIndexOf('/');
+                                    if (slash > 0) return path.substring(0, slash);
+                                    return path;
+                                }
+                            }
+                            return "/data/app/" + pkg;
+                        }
+                        @Override
+                        protected void onPostExecute(String appPath) {
+                            openInRootExplorer(launcher, appPath);
+                        }
+                    }.execute();
+                }
+            };
+        }
+    }
