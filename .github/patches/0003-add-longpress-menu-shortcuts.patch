+    // ─────────────────────────────────────────────────────────────────────────
+    // Advanced Permissions shortcut
+    // Opens usage-stats, all-files and unknown-sources settings for the app.
+    // ─────────────────────────────────────────────────────────────────────────
+    public static class AdvancedPermissions extends SystemShortcut {
+        public AdvancedPermissions() {
+            super(R.drawable.ic_setting, R.string.action_advanced_permissions);
+        }
+
+        @Override
+        public View.OnClickListener getOnClickListener(final Launcher launcher,
+                final ItemInfo itemInfo) {
+            final String pkg = itemInfo.getTargetComponent() != null
+                    ? itemInfo.getTargetComponent().getPackageName() : null;
+            if (pkg == null) return null;
+            return new View.OnClickListener() {
+                @Override
+                public void onClick(View v) {
+                    AbstractFloatingView.closeAllOpenViews(launcher);
+                    // Usage stats
+                    try {
+                        launcher.startActivity(new Intent(ACTION_USAGE_ACCESS_SETTINGS));
+                    } catch (Exception ignored) {}
+                    // All-files (Android R+)
+                    try {
+                        Intent allFiles = new Intent(ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION,
+                                Uri.parse("package:" + pkg));
+                        launcher.startActivity(allFiles);
+                    } catch (Exception e) {
+                        try {
+                            launcher.startActivity(
+                                    new Intent(ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION));
+                        } catch (Exception ignored) {}
+                    }
+                    // Unknown sources (Android O+)
+                    try {
+                        Intent unknown = new Intent(ACTION_MANAGE_UNKNOWN_APP_SOURCES,
+                                Uri.parse("package:" + pkg));
+                        launcher.startActivity(unknown);
+                    } catch (Exception ignored) {}
+                }
+            };
+        }
+    }
