+package com.android.launcher3.util;
+
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.net.Uri;
+import android.support.v4.content.FileProvider;
+import android.util.Log;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+/**
+ * Builds a shareable URI for an app's APK file(s).
+ * If the app ships as split APKs they are merged into a single zip-like .apks bundle
+ * in the app's external cache directory before sharing.
+ *
+ * NOTE: Must NOT be called on the main thread.
+ */
+public class ApkShareHelper {
+
+    private static final String TAG = "ApkShareHelper";
+    private static final String AUTHORITY_SUFFIX = ".launcher3.fileprovider";
+
+    /**
+     * Returns a content:// URI suitable for sharing, or null on failure.
+     */
+    public static Uri buildShareUri(Context context, String packageName) {
+        try {
+            ApplicationInfo ai = context.getPackageManager()
+                    .getApplicationInfo(packageName, 0);
+
+            // Collect all APK paths
+            List<String> apkPaths = new ArrayList<>();
+            apkPaths.add(ai.sourceDir);
+            if (ai.splitSourceDirs != null) {
+                for (String split : ai.splitSourceDirs) {
+                    apkPaths.add(split);
+                }
+            }
+
+            File cacheDir = new File(context.getExternalCacheDir(), "shared_apks");
+            if (!cacheDir.exists()) cacheDir.mkdirs();
+
+            File outFile;
+            if (apkPaths.size() == 1) {
+                // Single APK – copy it
+                outFile = new File(cacheDir, packageName + ".apk");
+                copyFile(new File(apkPaths.get(0)), outFile);
+            } else {
+                // Split APKs – bundle into .apks (zip)
+                outFile = new File(cacheDir, packageName + ".apks");
+                bundleApks(apkPaths, outFile);
+            }
+
+            return FileProvider.getUriForFile(context,
+                    context.getPackageName() + AUTHORITY_SUFFIX, outFile);
+
+        } catch (Exception e) {
+            Log.e(TAG, "buildShareUri failed for " + packageName, e);
+            return null;
+        }
+    }
+
+    private static void copyFile(File src, File dst) throws IOException {
+        try (InputStream in = new FileInputStream(src);
+             OutputStream out = new FileOutputStream(dst)) {
+            byte[] buf = new byte[8192];
+            int len;
+            while ((len = in.read(buf)) > 0) out.write(buf, 0, len);
+        }
+    }
+
+    private static void bundleApks(List<String> apkPaths, File outFile) throws IOException {
+        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(outFile))) {
+            for (String path : apkPaths) {
+                File apk = new File(path);
+                ZipEntry entry = new ZipEntry(apk.getName());
+                zos.putNextEntry(entry);
+                try (FileInputStream fis = new FileInputStream(apk)) {
+                    byte[] buf = new byte[8192];
+                    int len;
+                    while ((len = fis.read(buf)) > 0) zos.write(buf, 0, len);
+                }
+                zos.closeEntry();
+            }
+        }
+    }
+}
