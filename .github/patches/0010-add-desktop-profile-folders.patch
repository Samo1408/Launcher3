+
+    /**
+     * Creates one FolderInfo per secondary user profile on the first desktop screen.
+     * Each folder is named after the user (e.g. "user 10") and contains every app
+     * installed for that user.
+     *
+     * This runs on the loader thread, before workspace is bound, so it is safe to
+     * mutate mBgDataModel directly.
+     */
+    private void injectDesktopProfileFolders(Context context) {
+        UserManager um = (UserManager) context.getSystemService(Context.USER_SERVICE);
+        if (um == null) return;
+
+        List<UserHandle> allProfiles = um.getUserProfiles();
+        UserHandle primaryUser = Process.myUserHandle();
+
+        for (UserHandle profile : allProfiles) {
+            if (profile.equals(primaryUser)) continue; // skip primary user
+
+            long serial = um.getSerialNumberForUser(profile);
+            String folderName = "user " + serial;
+
+            // Check if a folder with this name already exists on the workspace
+            boolean exists = false;
+            synchronized (mBgDataModel) {
+                for (FolderInfo fi : mBgDataModel.folders.values()) {
+                    if (folderName.equalsIgnoreCase(fi.title != null ? fi.title.toString() : "")) {
+                        exists = true;
+                        break;
+                    }
+                }
+            }
+            if (exists) continue;
+
+            // Build list of apps for this profile
+            List<AppInfo> profileApps = new ArrayList<>();
+            synchronized (mBgDataModel) {
+                for (AppInfo ai : mBgDataModel.appIconCache.values()) {
+                    if (profile.equals(ai.user)) {
+                        profileApps.add(ai);
+                    }
+                }
+            }
+            if (profileApps.isEmpty()) continue;
+
+            // Create the folder info
+            FolderInfo folder = new FolderInfo();
+            folder.title = folderName;
+            folder.container = LauncherSettings.Favorites.CONTAINER_DESKTOP;
+            folder.screenId = 0;
+            folder.cellX = 0;
+            folder.cellY = 0;
+
+            // Add shortcuts to folder
+            for (AppInfo ai : profileApps) {
+                ShortcutInfo si = new ShortcutInfo(ai);
+                si.container = folder.id;
+                folder.add(si, false);
+            }
+
+            // Persist and add to data model
+            synchronized (mBgDataModel) {
+                mBgDataModel.addOrMoveToFolder(folder);
+            }
+        }
+    }
